# Standalone deployment defaults to public-byok: visitors bring their own API key.
# Use SITE_ACCESS_MODE=private + SITE_PASSWORD for a private server-key deployment.
# The values below apply only to local dev or explicitly private server-key mode.
# Copy this file to .env.local and put your API key there. Never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# For providers that support Chat Completions JSON Schema instead of Responses, use chat.
AI_API_STYLE=responses
